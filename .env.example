# 複製此檔為 .env 並填入你的設定（.env 已被 gitignore，不會進版本庫）

# ── 永豐 Shioaji（台股下單）──────────────────────────────
# 至 SinoTrade 申請 API token：https://www.sinotrade.com.tw/
SJ_API_KEY=
SJ_SECRET_KEY=
# 實盤需要 CA 憑證（simulation 模式不需要）
SJ_CA_PATH=
SJ_CA_PASSWD=
SJ_PERSON_ID=

# ── 券商同步（選填）─────────────────────────────────────
# 設為 1 = 週掃描調倉時同步下單到 Shioaji（預設不啟用）
EXECUTE_BROKER=
# 設為 0 = 正式盤（需 CA 憑證）;預設 1 = 模擬盤
SJ_SIMULATION=1

# ── Discord 通知（選填；留空 = 通知功能靜默停用）────────
DISCORD_WEBHOOK=

# ── Dashboard 認證（magic link）──────────────────────────
# 允許登入的 email（逗號分隔）
ALLOWED_EMAILS=
DASH_BASE_URL=http://localhost:8787
# Gmail SMTP（寄 magic link 驗證信）
GMAIL_USER=
GMAIL_APP_PASSWORD=
