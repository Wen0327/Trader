# 複製此檔為 .env 並填入你的金鑰(.env 已被 gitignore,不會進版本庫)
# 幣安正式環境(只開「讀取 + 現貨交易」權限,綁定 IP 白名單,不要開提幣權限)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 幣安現貨 Testnet(https://testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# 幣安合約 Testnet(https://testnet.binancefuture.com)
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=

# Discord 通知(選填;留空 = 通知功能靜默停用)
DISCORD_WEBHOOK=

# 認證(magic link)
ALLOWED_EMAILS=
DASH_BASE_URL=http://localhost:8787
GMAIL_USER=
GMAIL_APP_PASSWORD=
